[Unit]
Description=Renew Xiaobu public IP certificate
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/letsencrypt/renewal/14.103.24.55.conf

[Service]
Type=oneshot
ExecStart=/opt/xiaobu-certbot/bin/certbot renew --quiet --non-interactive --cert-name 14.103.24.55 --no-random-sleep-on-renew
TimeoutStartSec=300
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
UMask=0077
